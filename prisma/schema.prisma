// Schema mirrors docs/DATA_MODEL.md — keep both in sync when this changes.
// learn more: https://pris.ly/d/prisma-schema
//
// Postgres (hosted on Supabase — see docs/STACK.md), used for both local
// dev and production. Enum-like fields are real `enum` columns and
// weekday selections are real array columns — Postgres supports both
// natively, unlike the SQLite this schema started on.

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // No native query-engine binary at all — queries go through the `pg`
  // driver via @prisma/adapter-pg instead. This is what actually ends
  // the "wrong platform binary" problem, rather than continuing to
  // guess which binaryTargets string Vercel's runtime wants.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalFrequencyType {
  DAILY
  SPECIFIC_DAYS
  WEEKLY_TARGET
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum WeightUnit {
  KG
  LB
}

enum ReminderChannel {
  PUSH
  EMAIL
}

enum WorkoutType {
  STRENGTH
  CARDIO
}

enum WorkoutMetric {
  SESSIONS
  MINUTES
}

enum DistanceUnit {
  KM
  MI
}

// Chosen per-activity on the post-finish summary screen — "keep to
// yourself" vs "share with friends" — sitting alongside (not replacing)
// the account-level share*Streak switches: the friend feed requires both.
enum ActivityVisibility {
  PRIVATE
  FRIENDS
}

// Fixed times of day a reminder can fire at, rather than an arbitrary
// "HH:mm" — see the Reminder model below for why: Vercel's Hobby cron plan
// only allows each individual cron job to fire once a day, but a project
// can register several separate cron jobs, each pinned to one of these
// slots, which is what actually makes "more than one reminder a day"
// possible without a paid plan.
enum ReminderSlot {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  // Public handle — used for finding/adding friends without exposing an
  // email address (see /friends). Set at signup; distinct from `name`,
  // which is just a display name and doesn't have to be unique.
  username  String   @unique
  // Set whenever username actually changes (not on signup) — gates the
  // 7-day change cooldown in settings/actions.ts. Null means "never
  // changed since signup," which the cooldown check treats as free to change.
  usernameChangedAt DateTime?
  name      String
  createdAt DateTime @default(now())

  // Every account has its own password (scrypt hash) set at signup — no
  // more shared APP_PASSWORD fallback now that signup is real.
  // sessionToken is the current logged-in session, if any — set on
  // login, cleared on logout or when the password changes.
  passwordHash String
  sessionToken String? @unique

  // Display/input preference for the Workout tracker — everything is
  // still stored canonically in kg/km regardless of this, converted at
  // the UI's edges (see src/lib/workout.ts).
  weightUnit   WeightUnit   @default(KG)
  distanceUnit DistanceUnit @default(KM)

  // Simple points total — +XP for finishing a study session or workout,
  // completing a goal for the day, or writing a journal entry (see each
  // action for the exact amounts). Level is derived from this at display
  // time (see lib/xp.ts) rather than stored separately, so the level
  // formula can change later without a migration.
  xp Int @default(0)

  // Opt-in privacy for the friends feed, per category — an accepted friend
  // can always see *that* you're a friend, but only sees a given streak
  // when its switch is on. Split three ways (rather than one blanket
  // toggle) so someone can, say, show their workout streak without also
  // showing their journal streak. All default on since the whole point of
  // adding a friend is to see each other's progress. Level is always
  // visible to friends regardless — it's just derived from total XP across
  // everything, not any one category.
  shareJournalStreak Boolean @default(true)
  shareStudyStreak   Boolean @default(true)
  shareWorkoutStreak Boolean @default(true)

  // Public profile fields — nullable at the schema level so an existing
  // account never breaks, but birthday/gender/city are treated as required
  // by the app itself: /onboarding gates the rest of the app behind them
  // (see hasCompletedProfile in lib/user.ts), shown right after signup
  // and to any older account that predates this. bio/avatarUrl/pronouns/
  // weightKg/heightCm stay genuinely optional even there.
  birthday  DateTime?
  gender    Gender?
  city      String?
  bio       String?
  pronouns  String?
  avatarUrl String?
  // Canonical SI units, same convention as workout's weightUnit/distanceUnit
  // — converted at the UI's edges, not stored in whatever unit was typed.
  weightKg Float?
  heightCm Float?

  journalEntries    JournalEntry[]
  goals             Goal[]
  subjects          Subject[]
  studySessions     StudySession[]
  exercises         Exercise[]
  workouts          Workout[]
  pushSubscriptions PushSubscription[]
  feedback          Feedback[]
  deadlines         Deadline[]
  badges            UserBadge[]

  following Follow[] @relation("Follower")
  followers Follow[] @relation("Following")
  cheersSent     Cheer[] @relation("CheerFrom")
  cheersReceived Cheer[] @relation("CheerTo")
}

model PushSubscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // The three fields a browser's PushSubscription.toJSON() gives you —
  // exactly what web-push needs to send a notification later.
  endpoint  String @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date        DateTime
  bodyText    String
  // Separate "what didn't go well / what to improve" reflection — kept as
  // its own field rather than folded into bodyText so the two can have
  // their own prompts and be shown/edited independently.
  improveText String?
  // 1 (bad) – 5 (great), from the daily 5-face mood tracker. Nullable —
  // most old entries won't have one, and answering it isn't required.
  mood Int?
  // The answer to that day's "Proudly Prompt of the Day". The prompt
  // itself isn't stored — it's derived from the date (see lib/prompts.ts)
  // — only what the user wrote in response.
  promptResponse String?
  // Public URL of a photo uploaded to Supabase Storage for this entry.
  // One photo per entry, kept simple on purpose.
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Feedback {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  message   String
  createdAt DateTime @default(now())
}

model Goal {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title       String
  description String?

  frequencyType GoalFrequencyType
  targetDays    Weekday[] // only used when frequencyType = SPECIFIC_DAYS

  targetValue Float? // e.g. 10 for "10 minutes"; null for simple yes/no goals
  unit        String? // e.g. "minutes", "sessions"

  // When set on a WEEKLY_TARGET goal, its weekly total is computed
  // automatically from StudySession minutes for this subject instead of
  // manual daily entry — this is the "study Maths 5 hours this week"
  // link from the study timer to the goal tracker.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  // Same idea as subjectId, but for the Workout tracker — mutually
  // exclusive with subjectId in practice (the form only ever sets one).
  // SESSIONS counts finished Workout rows in the week; MINUTES sums their
  // durationMinutes, mirroring the Study auto-track above.
  workoutMetric WorkoutMetric?

  active    Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())

  logs      GoalLog[]
  reminders Reminder[]
}

model GoalLog {
  id String @id @default(uuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id])

  date      DateTime
  completed Boolean  @default(false)
  value     Float?
  note      String?

  @@unique([goalId, date])
}

model Subject {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  name   String
  color  String
  active Boolean @default(true)

  studySessions StudySession[]
  goals         Goal[]
  deadlines     Deadline[]
}

model StudySession {
  id String @id @default(uuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  startedAt       DateTime
  // Set while the timer is paused. On resume, startedAt is shifted forward
  // by the paused duration and this is cleared — so elapsed time (now -
  // startedAt) stays correct without a separate accumulator field.
  pausedAt        DateTime?
  endedAt         DateTime?
  durationMinutes Int?
  note            String?

  // Chosen on the post-finish summary screen (Strava-style "who can see
  // this"), independent of the account-level shareStudyStreak switch — the
  // friend feed requires both: shareStudyStreak on, AND this session
  // specifically set to FRIENDS. Defaults to FRIENDS so it matches the
  // account-level default without extra friction for someone who's already
  // opted their whole category in.
  visibility ActivityVisibility @default(FRIENDS)

  // Every query here filters by userId, usually combined with a startedAt
  // range (week/day views) — without this, those become sequential scans
  // once a user's session history grows past what a personal app starts
  // with.
  @@index([userId, startedAt])
}

model Exercise {
  id String @id @default(uuid())

  userId String? // null = built-in library item
  user   User?   @relation(fields: [userId], references: [id])

  name     String
  category String
  isCustom Boolean @default(false)

  sets WorkoutSet[]
}

model Workout {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type WorkoutType @default(STRENGTH)

  date            DateTime
  label           String
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int?
  // Cardio only — distance is tracked live via the browser's geolocation
  // API while the session runs (or entered by hand as a fallback), and
  // pace is derived at render time from this and durationMinutes rather
  // than stored.
  distanceKm Float?
  // Cardio only — the tracked GPS points ({lat, lng, t, alt}[], in order,
  // t/alt best-effort), null if GPS wasn't available/used for this session.
  // Splits and elevation gain (see lib/workout.ts) are derived from this at
  // render time rather than stored, same convention as pace.
  route Json?
  note  String?
  // See StudySession.visibility for how this and shareWorkoutStreak
  // together gate the friend feed.
  visibility ActivityVisibility @default(FRIENDS)
  // Optional photo attached on the post-finish summary screen — same
  // Supabase Storage bucket/pattern as JournalEntry.photoUrl.
  photoUrl String?

  sets WorkoutSet[]

  // Same reasoning as StudySession's index — every query here filters by
  // userId, usually with a date range too.
  @@index([userId, date])
}

model WorkoutSet {
  id String @id @default(uuid())

  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id])
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  setNumber Int
  reps      Int
  weight    Float

  weightUnit WeightUnit @default(KG)
  isWarmup   Boolean    @default(false)

  // addSet/removeSet count and list sets by workoutId on every single set
  // logged — the most frequent write in the app, and the one the "adding
  // an exercise feels slow at the gym" complaint pointed at. exerciseId is
  // indexed too for the "last time you did this" and progression lookups,
  // which group across a user's whole history.
  @@index([workoutId])
  @@index([exerciseId])
}

model Reminder {
  id String @id @default(uuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id])

  daysOfWeek Weekday[]
  // Which of the day's fixed slots to fire in — a goal can be reminded in
  // more than one (e.g. both MORNING and EVENING), each delivered by its
  // own cron job (see vercel.json and the cron route).
  slots ReminderSlot[]

  channel ReminderChannel
  enabled Boolean         @default(true)
}

model Deadline {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title String
  // Optional link to a Subject, same idea as Goal.subjectId — lets a
  // deadline show up alongside that subject's study time without forcing
  // one, since not every deadline (a library book, a form to submit) maps
  // to a subject.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  dueDate DateTime
  // "HH:mm", 24h, always set (defaults to end of day) — reminders are
  // computed as offsets from dueDate+dueTime, so a real time is needed
  // even though the UI treats it as optional (end of day is a sensible
  // default for "due the 15th" with no time given).
  dueTime   String   @default("23:59")
  notes     String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  remindersSent DeadlineReminderSent[]
}

enum DeadlineReminderKind {
  WEEK_BEFORE
  DAY_BEFORE
  HOUR_BEFORE
}

// One row per (deadline, kind) once that reminder has actually been sent —
// checked by the cron route before sending, so an hourly check that spans
// the target moment more than once (or catches up after a gap) never
// double-sends.
model DeadlineReminderSent {
  id         String                @id @default(uuid())
  deadlineId String
  deadline   Deadline              @relation(fields: [deadlineId], references: [id])
  kind       DeadlineReminderKind
  sentAt     DateTime              @default(now())

  @@unique([deadlineId, kind])
}

// One-directional, Strava-style — following someone needs no acceptance
// from them, so followerId and followingId aren't symmetric the way the
// old Friendship pair was. A "FRIENDS"-visibility activity (see
// ActivityVisibility) shows to whoever follows its owner, regardless of
// whether the owner follows back.
model Follow {
  id String @id @default(uuid())

  followerId  String
  follower    User   @relation("Follower", fields: [followerId], references: [id])
  followingId String
  following   User   @relation("Following", fields: [followingId], references: [id])

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  // followerId is already covered as the leading column of the unique
  // index above — followingId needs its own, since "who follows me" (feed
  // + follower-count) lookups filter by it just as often.
  @@index([followingId])
}

// A "like" on one specific activity in a friend's feed (a finished workout
// or study session — see the friend-feed query in friends/page.tsx), not a
// once-a-day thing anymore. Exactly one of workoutId/studySessionId is set
// per row; each is its own unique constraint (rather than one combined
// constraint) so a like on a workout and a like on a study session never
// collide just because both FK columns happen to be null on unrelated rows
// — Postgres treats NULLs as distinct within a unique index, so that's safe.
// Deliberately plain string FKs (no Prisma @relation) — a like on an
// activity that's since been deleted just stops showing up in the feed,
// which needs no cleanup or cascade of its own.
model Cheer {
  id String @id @default(uuid())

  fromUserId String
  fromUser   User   @relation("CheerFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User   @relation("CheerTo", fields: [toUserId], references: [id])

  workoutId      String?
  studySessionId String?

  createdAt DateTime @default(now())

  @@unique([fromUserId, workoutId])
  @@unique([fromUserId, studySessionId])
  // The friend feed's like-count lookup filters by workoutId/studySessionId
  // directly (not fromUserId), which the two unique indexes above don't
  // cover since fromUserId is their leading column.
  @@index([workoutId])
  @@index([studySessionId])
}

// A curated, fixed set of milestones rather than an open-ended point
// system — same reasoning as the old accent-theme presets: each one is
// hand-picked to mean something specific, rather than derived from a
// formula that could quietly change what a badge "means" later.
enum Badge {
  FIRST_JOURNAL_ENTRY
  FIRST_STUDY_SESSION
  FIRST_WORKOUT
  FIRST_GOAL_COMPLETE
  FIRST_DEADLINE_COMPLETE
  JOURNAL_STREAK_7
  JOURNAL_STREAK_30
  JOURNAL_STREAK_100
  STUDY_STREAK_7
  STUDY_STREAK_30
  WORKOUT_STREAK_7
  WORKOUT_STREAK_30
  LEVEL_5
  LEVEL_10
  LEVEL_20
  LEVEL_50
  TOTAL_WORKOUTS_10
  TOTAL_WORKOUTS_50
  TOTAL_WORKOUTS_100
  TOTAL_STUDY_HOURS_10
  TOTAL_STUDY_HOURS_50
  FIRST_FRIEND
  EARLY_BIRD
  NIGHT_OWL
}

model UserBadge {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  badge  Badge

  earnedAt DateTime @default(now())

  @@unique([userId, badge])
}
