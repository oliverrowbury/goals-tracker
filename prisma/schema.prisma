// Schema mirrors docs/DATA_MODEL.md — keep both in sync when this changes.
// learn more: https://pris.ly/d/prisma-schema
//
// Postgres (hosted on Supabase — see docs/STACK.md), used for both local
// dev and production. Enum-like fields are real `enum` columns and
// weekday selections are real array columns — Postgres supports both
// natively, unlike the SQLite this schema started on.

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // No native query-engine binary at all — queries go through the `pg`
  // driver via @prisma/adapter-pg instead. This is what actually ends
  // the "wrong platform binary" problem, rather than continuing to
  // guess which binaryTargets string Vercel's runtime wants.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalFrequencyType {
  DAILY
  SPECIFIC_DAYS
  WEEKLY_TARGET
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum WeightUnit {
  KG
  LB
}

enum ReminderChannel {
  PUSH
  EMAIL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  journalEntries JournalEntry[]
  goals          Goal[]
  subjects       Subject[]
  studySessions  StudySession[]
  exercises      Exercise[]
  workouts       Workout[]
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  bodyText  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Goal {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title       String
  description String?

  frequencyType GoalFrequencyType
  targetDays    Weekday[] // only used when frequencyType = SPECIFIC_DAYS

  targetValue Float? // e.g. 10 for "10 minutes"; null for simple yes/no goals
  unit        String? // e.g. "minutes", "sessions"

  active    Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())

  logs      GoalLog[]
  reminders Reminder[]
}

model GoalLog {
  id String @id @default(uuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id])

  date      DateTime
  completed Boolean  @default(false)
  value     Float?
  note      String?

  @@unique([goalId, date])
}

model Subject {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  name   String
  color  String

  studySessions StudySession[]
}

model StudySession {
  id String @id @default(uuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  note            String?
}

model Exercise {
  id String @id @default(uuid())

  userId String? // null = built-in library item
  user   User?   @relation(fields: [userId], references: [id])

  name     String
  category String
  isCustom Boolean @default(false)

  sets WorkoutSet[]
}

model Workout {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  date      DateTime
  label     String
  startedAt DateTime?
  endedAt   DateTime?
  note      String?

  sets WorkoutSet[]
}

model WorkoutSet {
  id String @id @default(uuid())

  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id])
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  setNumber Int
  reps      Int
  weight    Float

  weightUnit WeightUnit @default(KG)
  isWarmup   Boolean    @default(false)
}

model Reminder {
  id String @id @default(uuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id])

  daysOfWeek Weekday[]
  timeOfDay  String // "HH:mm", 24h

  channel ReminderChannel
  enabled Boolean         @default(true)
}
