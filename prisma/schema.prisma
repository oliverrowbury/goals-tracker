// Schema mirrors docs/DATA_MODEL.md — keep both in sync when this changes.
// learn more: https://pris.ly/d/prisma-schema
//
// Postgres (hosted on Supabase — see docs/STACK.md), used for both local
// dev and production. Enum-like fields are real `enum` columns and
// weekday selections are real array columns — Postgres supports both
// natively, unlike the SQLite this schema started on.

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // No native query-engine binary at all — queries go through the `pg`
  // driver via @prisma/adapter-pg instead. This is what actually ends
  // the "wrong platform binary" problem, rather than continuing to
  // guess which binaryTargets string Vercel's runtime wants.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalFrequencyType {
  DAILY
  SPECIFIC_DAYS
  WEEKLY_TARGET
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum WeightUnit {
  KG
  LB
}

enum ReminderChannel {
  PUSH
  EMAIL
}

enum WorkoutType {
  STRENGTH
  CARDIO
}

enum WorkoutMetric {
  SESSIONS
  MINUTES
}

enum DistanceUnit {
  KM
  MI
}

// A curated set of accent-color presets a user can pick in Settings, rather
// than a free-form color picker — keeps every combination looking
// intentional and keeps contrast/accessibility guaranteed, since each is
// hand-picked rather than user-mixed. TERRACOTTA is the original default.
enum AccentTheme {
  TERRACOTTA
  OCEAN
  FOREST
  BERRY
  SLATE
}

// Fixed times of day a reminder can fire at, rather than an arbitrary
// "HH:mm" — see the Reminder model below for why: Vercel's Hobby cron plan
// only allows each individual cron job to fire once a day, but a project
// can register several separate cron jobs, each pinned to one of these
// slots, which is what actually makes "more than one reminder a day"
// possible without a paid plan.
enum ReminderSlot {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  // Every account has its own password (scrypt hash) set at signup — no
  // more shared APP_PASSWORD fallback now that signup is real.
  // sessionToken is the current logged-in session, if any — set on
  // login, cleared on logout or when the password changes.
  passwordHash String
  sessionToken String? @unique

  // Display/input preference for the Workout tracker — everything is
  // still stored canonically in kg/km regardless of this, converted at
  // the UI's edges (see src/lib/workout.ts).
  weightUnit   WeightUnit   @default(KG)
  distanceUnit DistanceUnit @default(KM)

  // Which preset color palette the app renders in for this user — applied
  // as a data attribute on the app shell, see globals.css.
  accentTheme AccentTheme @default(TERRACOTTA)

  // Simple points total — +XP for finishing a study session or workout,
  // completing a goal for the day, or writing a journal entry (see each
  // action for the exact amounts). Level is derived from this at display
  // time (see lib/xp.ts) rather than stored separately, so the level
  // formula can change later without a migration.
  xp Int @default(0)

  // Opt-in privacy for the friends feed: an accepted friend can always see
  // *that* you're a friend, but only sees streaks/level/recent activity
  // when this is on. Defaults on since the whole point of adding a friend
  // is to see each other's progress, but this is the one switch to turn
  // that back off without having to remove anyone.
  shareActivity Boolean @default(true)

  journalEntries    JournalEntry[]
  goals             Goal[]
  subjects          Subject[]
  studySessions     StudySession[]
  exercises         Exercise[]
  workouts          Workout[]
  pushSubscriptions PushSubscription[]
  feedback          Feedback[]
  deadlines         Deadline[]

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
}

model PushSubscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // The three fields a browser's PushSubscription.toJSON() gives you —
  // exactly what web-push needs to send a notification later.
  endpoint  String @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date        DateTime
  bodyText    String
  // Separate "what didn't go well / what to improve" reflection — kept as
  // its own field rather than folded into bodyText so the two can have
  // their own prompts and be shown/edited independently.
  improveText String?
  // 1 (bad) – 5 (great), from the daily 5-face mood tracker. Nullable —
  // most old entries won't have one, and answering it isn't required.
  mood Int?
  // The answer to that day's "Proudly Prompt of the Day". The prompt
  // itself isn't stored — it's derived from the date (see lib/prompts.ts)
  // — only what the user wrote in response.
  promptResponse String?
  // Public URL of a photo uploaded to Supabase Storage for this entry.
  // One photo per entry, kept simple on purpose.
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Feedback {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  message   String
  createdAt DateTime @default(now())
}

model Goal {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title       String
  description String?

  frequencyType GoalFrequencyType
  targetDays    Weekday[] // only used when frequencyType = SPECIFIC_DAYS

  targetValue Float? // e.g. 10 for "10 minutes"; null for simple yes/no goals
  unit        String? // e.g. "minutes", "sessions"

  // When set on a WEEKLY_TARGET goal, its weekly total is computed
  // automatically from StudySession minutes for this subject instead of
  // manual daily entry — this is the "study Maths 5 hours this week"
  // link from the study timer to the goal tracker.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  // Same idea as subjectId, but for the Workout tracker — mutually
  // exclusive with subjectId in practice (the form only ever sets one).
  // SESSIONS counts finished Workout rows in the week; MINUTES sums their
  // durationMinutes, mirroring the Study auto-track above.
  workoutMetric WorkoutMetric?

  active    Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())

  logs      GoalLog[]
  reminders Reminder[]
}

model GoalLog {
  id String @id @default(uuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id])

  date      DateTime
  completed Boolean  @default(false)
  value     Float?
  note      String?

  @@unique([goalId, date])
}

model Subject {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  name   String
  color  String
  active Boolean @default(true)

  studySessions StudySession[]
  goals         Goal[]
  deadlines     Deadline[]
}

model StudySession {
  id String @id @default(uuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  startedAt       DateTime
  // Set while the timer is paused. On resume, startedAt is shifted forward
  // by the paused duration and this is cleared — so elapsed time (now -
  // startedAt) stays correct without a separate accumulator field.
  pausedAt        DateTime?
  endedAt         DateTime?
  durationMinutes Int?
  note            String?
}

model Exercise {
  id String @id @default(uuid())

  userId String? // null = built-in library item
  user   User?   @relation(fields: [userId], references: [id])

  name     String
  category String
  isCustom Boolean @default(false)

  sets WorkoutSet[]
}

model Workout {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type WorkoutType @default(STRENGTH)

  date            DateTime
  label           String
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int?
  // Cardio only — distance is tracked live via the browser's geolocation
  // API while the session runs (or entered by hand as a fallback), and
  // pace is derived at render time from this and durationMinutes rather
  // than stored.
  distanceKm Float?
  // Cardio only — the tracked GPS points ({lat, lng}[], in order), null if
  // GPS wasn't available/used for this session. Just enough to draw the
  // route on a map; no elevation, timestamps, or per-point accuracy kept.
  route Json?
  note  String?

  sets WorkoutSet[]
}

model WorkoutSet {
  id String @id @default(uuid())

  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id])
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  setNumber Int
  reps      Int
  weight    Float

  weightUnit WeightUnit @default(KG)
  isWarmup   Boolean    @default(false)
}

model Reminder {
  id String @id @default(uuid())

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id])

  daysOfWeek Weekday[]
  // Which of the day's fixed slots to fire in — a goal can be reminded in
  // more than one (e.g. both MORNING and EVENING), each delivered by its
  // own cron job (see vercel.json and the cron route).
  slots ReminderSlot[]

  channel ReminderChannel
  enabled Boolean         @default(true)
}

model Deadline {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title String
  // Optional link to a Subject, same idea as Goal.subjectId — lets a
  // deadline show up alongside that subject's study time without forcing
  // one, since not every deadline (a library book, a form to submit) maps
  // to a subject.
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  dueDate   DateTime
  notes     String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// One row per pair, not two — requester sent it, addressee either accepts
// (status flips to ACCEPTED, same row) or the row is deleted (declined, or
// an accepted friendship removed). A pair is unique regardless of
// direction, enforced in application code (see friends/actions.ts) rather
// than the schema, since Postgres can't express "unordered pair unique" as
// a plain constraint without also normalizing which id goes first.
model Friendship {
  id String @id @default(uuid())

  requesterId String
  requester   User   @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User   @relation("FriendshipAddressee", fields: [addresseeId], references: [id])

  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@unique([requesterId, addresseeId])
}
