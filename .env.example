# Get this from your Supabase project: Project Settings -> Database ->
# Connection string -> URI (use the "Transaction pooler" one for serverless
# hosts like Vercel).
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Transactional email (welcome email on signup, password-changed
# confirmation) via Resend — https://resend.com. Sign up (free tier is
# plenty for this), create an API key, and either verify your own sending
# domain or leave EMAIL_FROM unset to send from Resend's shared onboarding
# domain (fine for testing, not for real users). Without RESEND_API_KEY set,
# emails are just logged instead of sent — nothing else breaks.
RESEND_API_KEY=""
EMAIL_FROM="Proudly <onboarding@resend.dev>"

# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Any random string — Vercel Cron sends it back as a Bearer token so the
# reminders endpoint can tell a real cron trigger from a random request.
CRON_SECRET=""

# Same Supabase project as DATABASE_URL, used for the journal-photos
# Storage bucket (Project Settings -> Data API -> Project URL, and
# Project Settings -> API Keys -> anon/publishable key).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Optional — error monitoring via Sentry (https://sentry.io, free tier is
# plenty). Completely inactive until these are set (see
# src/instrumentation.ts / src/instrumentation-client.ts), so leaving them
# blank changes nothing else. SENTRY_DSN covers server/edge errors,
# NEXT_PUBLIC_SENTRY_DSN covers the browser — same DSN value in both, just
# under the two different names each side actually reads.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
