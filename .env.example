# Get this from your Supabase project: Project Settings -> Database ->
# Connection string -> URI (use the "Transaction pooler" one for serverless
# hosts like Vercel).
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Simple password gate for Phase 1 (single user). Change this to whatever
# you like — it's read by src/proxy.ts and src/app/api/login/route.ts.
APP_PASSWORD="year13goals"
